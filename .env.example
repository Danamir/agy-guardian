# Local machine settings for agy-guardian
# Copy to `.env` and fill in your local paths (`.env` is gitignored).

# Optional explicit path to llama-server (e.g., CUDA or Vulkan build).
# Leave empty to use `llama-server` from PATH.
AGY_GUARDIAN_LLAMA_SERVER=

# Local llama-server host and port
AGY_GUARDIAN_HOST=127.0.0.1
AGY_GUARDIAN_PORT=8099

# Model directories (expanded in model manifests via ${AGY_GUARDIAN_DECISION_MODELS_DIR}, etc.)
AGY_GUARDIAN_DECISION_MODELS_DIR=
AGY_GUARDIAN_LLM_MODELS_DIR=

# Production server model & hook runtime settings
AGY_GUARDIAN_MODEL_PATH=${AGY_GUARDIAN_DECISION_MODELS_DIR}/Cloudflare_clef-flash-Q5_K_M.gguf
AGY_GUARDIAN_GPU_LAYERS=99
AGY_GUARDIAN_BACKEND=systemone
AGY_GUARDIAN_SCHEMA_MODE=multi
AGY_GUARDIAN_TIMEOUT_SEC=4.0
# Optional fallback endpoint for /v1/chat/completions when primary fails
AGY_GUARDIAN_FALLBACK_ENDPOINT=
# JSONL audit log path (leave empty for ~/.gemini/config/agy_guardian.log.jsonl; set `off` to disable)
AGY_GUARDIAN_AUDIT_LOG=
AGY_GUARDIAN_AUDIT_FAIL_CLOSED=true
# Audit log rotation (default: 5 MiB per file, 3 rotated backups; set 0 to disable rotation)
AGY_GUARDIAN_AUDIT_MAX_BYTES=5242880
AGY_GUARDIAN_AUDIT_BACKUPS=3
# Per-project policy JSON stored outside writable workspaces
# (leave empty for ~/.gemini/config/agy_guardian_policies.json; set `off` to disable)
AGY_GUARDIAN_POLICY_FILE=
# Optional semicolon-separated global extra trusted workspace roots (supports \\wsl.localhost\...)
AGY_GUARDIAN_EXTRA_WORKSPACES=
# Automatically allow read/write inside the current Antigravity session's brain directory
# (~/.gemini/antigravity-cli/brain/<conversationId>, strictly scoped to the active conversationId)
AGY_GUARDIAN_ALLOW_SESSION_BRAIN=true

# Benchmark defaults
AGY_GUARDIAN_MANIFEST=.local/models.json
AGY_GUARDIAN_OUTPUT_DIR=.local/benchmark_results

# Fail-closed classifier thresholds
AGY_GUARDIAN_ALLOW_THRESHOLD=0.90
AGY_GUARDIAN_DENY_THRESHOLD=0.85
AGY_GUARDIAN_RISK_MAX_PROB=0.25
